# Copy this file to .env for your own reference, then set the variables in your terminal before starting
# the application (the app reads environment variables; it does not load this file automatically).
#
# PowerShell example:
#   $env:SECRET_KEY = python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# NEVER commit a real .env file or any real secret.

# --- Section B (Flask) -----------------------------------------------------------------------
# Required for real use. Sessions and CSRF tokens are signed with this value.
SECRET_KEY=replace-with-a-long-random-value-from-the-command-above

# Default: sqlite file inside Section_B_RBAC\instance\bank.db. Leave empty to use the default.
DATABASE_URL=

# Set to 1 only when the app is served over HTTPS (cookies are then sent only over HTTPS).
SESSION_COOKIE_SECURE=0

# Session expiry, enforced on the server.
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=8

# Show the demo accounts on the login page. Set to 0 for anything other than local marking/demo use.
SHOW_DEMO_CREDENTIALS=1

# --- Section D (cryptography) ----------------------------------------------------------------
# Folder for key files (default: Section_D_Cryptography\secure_keys). Keep it out of the ZIP and Git.
KEY_DIR=

# Optional keys supplied by a secrets manager instead of key files (base64, 32 bytes decoded).
# Generate one with:  python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
AES_DATA_KEY_B64=
HMAC_SIGNING_KEY_B64=
